{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://woia.dev/schemas/software/v0.5.0/methodology-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "software_version",
    "profile_seed",
    "phases",
    "transition_gates",
    "auxiliary_capabilities",
    "migration",
    "updated_at"
  ],
  "properties": {
    "schema": {
      "const": "dev.woia.software-methodology-state/v1"
    },
    "software_version": {
      "const": "0.5.0"
    },
    "profile_seed": {
      "type": [
        "string",
        "null"
      ]
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "capability",
          "contract",
          "status",
          "gate_status"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 23
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "required",
              "conditional",
              "not_applicable"
            ]
          },
          "reason_or_trigger": {
            "type": "string"
          },
          "gate_status": {
            "enum": [
              "pending",
              "satisfied",
              "blocked"
            ]
          },
          "receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "adopted_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "transition_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "capability",
          "contract",
          "status",
          "gate_status"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "required",
              "conditional",
              "not_applicable"
            ]
          },
          "gate_status": {
            "enum": [
              "pending",
              "satisfied",
              "blocked"
            ]
          },
          "receipt_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "auxiliary_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendations"
      ],
      "properties": {
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "name",
              "responsibility",
              "trigger"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "responsibility": {
                "type": "string"
              },
              "trigger": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
